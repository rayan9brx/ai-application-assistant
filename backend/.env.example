SPRING_PROFILES_ACTIVE=<local-or-prod>

# Optional: the server starts without it, and only scoring, fixes and tailoring then answer
# 503 "AI features aren't set up". Server-side only; never put it in the frontend.
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Supabase project URL, e.g. https://<project-ref>.supabase.co (used for JWKS and the Admin API).
SUPABASE_URL=<your-supabase-project-url>

# Supabase Postgres via the Session pooler (Dashboard > Connect > Session pooler), as JDBC:
# jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=<jdbc-session-pooler-url>
# Session pooler user, e.g. postgres.<project-ref>
SUPABASE_DB_USER=<db-user>
SUPABASE_DB_PASSWORD=<db-password>

# Secret key (sb_secret_...). Server-side only; used to delete auth users. Never put it in the frontend.
SUPABASE_SECRET_KEY=<your-supabase-secret-key>
